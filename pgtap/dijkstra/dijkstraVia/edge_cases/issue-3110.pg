BEGIN;
SET client_min_messages TO WARNING;

SELECT CASE WHEN min_version('4.0.1') THEN plan(6) ELSE plan(1) END;


CREATE OR REPLACE FUNCTION test_function()
RETURNS SETOF TEXT AS
$BODY$
BEGIN
  IF NOT min_version('4.0.1') THEN
    RETURN query
    SELECT skip(1, 'bad alloc erro Fixed on 4.0.1');
    RETURN;
  END IF;

  PREPARE data AS
  SELECT *
  FROM (
    VALUES
    (100, 1, 2, 1, 1),
    (101, 2, 3, 1, 1),
    (102, 3, 4, 1, 1)
  ) AS edge_table(id, source, target, cost, reverse_cost);

  RETURN QUERY
  SELECT lives_ok($$SELECT * FROM pgr_dijkstraVia('data', ARRAY[1, 3, 4] )$$,
    'dijkstraVia lives when all via vertices exist in the graph');
  RETURN QUERY
  SELECT isnt_empty($$SELECT * FROM pgr_dijkstraVia('data', ARRAY[1, 3, 4] )$$,
    'dijkstraVia lives when all via vertices exist in the graph');

  RETURN QUERY
  SELECT lives_ok($$SELECT * FROM pgr_dijkstraVia('data', ARRAY[1, 3, 5])$$,
    'dijkstraVia lives when a via vertex does not exist in the graph');
  RETURN QUERY
  SELECT isnt_empty($$SELECT * FROM pgr_dijkstraVia('data', ARRAY[1, 3, 5])$$,
    'dijkstraVia lives when a via vertex does not exist in the graph');


  RETURN QUERY
  SELECT lives_ok($$SELECT * FROM pgr_dijkstraVia('data', ARRAY[1, 5, 4])$$,
    'dijkstraVia handles via vertex missing between two valid vertices');
  RETURN QUERY
  SELECT is_empty($$SELECT * FROM pgr_dijkstraVia('data', ARRAY[1, 5, 4]);$$,
    'dijkstraVia handles via vertex missing between two valid vertices');
END
$BODY$
language plpgsql;

SELECT test_function();

SELECT * FROM finish();
ROLLBACK;
