BEGIN;

SELECT CASE WHEN min_version('4.1.0') THEN plan(10) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION disconnected()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

IF NOT min_version('4.1.0') THEN
  RETURN QUERY
  SELECT skip(1, 'Function is new on 4.1.0');
  RETURN;
END IF;

-- ==========================================================================
-- 1. Only the component that needs closure edges is touched
-- ==========================================================================

-- 1 -- 2-- 3-- 4; 5 -- 6 --7 --5;
-- Path 1-2-3-4 needs closure edges,
-- triangle 5-6-7-5 is already biconnected
CREATE TEMP TABLE dc_path_tri AS
SELECT id, source, target, cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::FLOAT),
  (2, 2, 3, 1),
  (3, 3, 4, 1),
  (4, 5, 6, 1),
  (5, 6, 7, 1),
  (6, 7, 5, 1))
AS t(id, source, target, cost);

RETURN QUERY
SELECT set_eq(
  $$SELECT start_vid, end_vid FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM dc_path_tri')$$,
  $$VALUES
    (1::BIGINT, 3::BIGINT),
    (2::BIGINT, 4::BIGINT)
  $$,
  '1: Path 1-2-3-4 + triangle 5-6-7-5 => only the path is modified');

-- ==========================================================================
-- 2-3. Disconnected graphs that are already biconnected need no edges
-- ==========================================================================

-- Three disjoint triangles: every component is already biconnected
-- 1-- 2-- 3-- 1; 4-- 5-- 6-- 4; 7-- 8 -- 9-- 7;
CREATE TEMP TABLE dc_three_tri AS
SELECT id, source, target, cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::FLOAT),
  (2, 2, 3, 1),
  (3, 3, 1, 1),
  (4, 4, 5, 1),
  (5, 5, 6, 1),
  (6, 6, 4, 1),
  (7, 7, 8, 1),
  (8, 8, 9, 1),
  (9, 9, 7, 1))
AS t(id, source, target, cost);

RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM dc_three_tri')$$,
  '2: Three disjoint triangles are already biconnected');

-- isolated edges: two-vertex components are trivially biconnected
-- 1-- 2; 3-- 4; 5-- 6
CREATE TEMP TABLE dc_fragments AS
SELECT id, source, target, cost
FROM (VALUES
  (1::BIGINT,  1::BIGINT,  2::BIGINT, 1::FLOAT),
  (2,  3,  4, 1),
  (3,  5,  6, 1))
AS t(id, source, target, cost);

RETURN QUERY
SELECT is_empty(
  $$SELECT * FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM dc_fragments')$$,
  '3: Eight isolated edges are already biconnected');

-- ==========================================================================
-- 4-5. Independent closure of each component
-- ==========================================================================

-- Two separate trees
-- 1-- {2,3}; 4-- {5,6};
CREATE TEMP TABLE dc_two_trees AS
SELECT id, source, target, cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::FLOAT),
  (2, 1, 3, 1),
  (3, 4, 5, 1),
  (4, 4, 6, 1))
AS t(id, source, target, cost);

RETURN QUERY
SELECT set_eq(
  $$SELECT start_vid, end_vid FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM dc_two_trees')$$,
  $$VALUES
    (2::BIGINT, 3::BIGINT),
    (5::BIGINT, 6::BIGINT)
  $$,
  '4: Two trees => each is closed independently');

-- path plus a disconnected single edge
-- 1--  2-- 3-- 4; 10-- 11
CREATE TEMP TABLE dc_path_edge AS
SELECT id, source, target, cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::FLOAT),
  (2, 2, 3, 1),
  (3, 3, 4, 1),
  (4, 10, 11, 1))
AS t(id, source, target, cost);

RETURN QUERY
SELECT set_eq(
  $$SELECT start_vid, end_vid FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM dc_path_edge')$$,
  $$VALUES
    (1::BIGINT, 3::BIGINT),
    (2::BIGINT, 4::BIGINT)
  $$,
  '5: Six-vertex path + isolated edge => edge 10-11 component untouched');

-- ==========================================================================
-- Biconnected graph property tests
--
-- The exact edges chosen by Boost implementation may change between Boost
-- releases, so the checks below assert invariants
-- ==========================================================================

-- Four components of mixed character
-- 1--  2-- 3-- 4; 10-- 11; 20-- 21-- 22; 30-- 31-- 32-- 30;
CREATE TEMP TABLE dc_mixed AS
SELECT id, source, target, cost
FROM (VALUES
--   {1,2,3,4}    path        needs 2 closure edges
  (1::BIGINT,  1::BIGINT,  2::BIGINT, 1::FLOAT),
  (2,  2,  3, 1),
  (3,  3,  4, 1),
--   {10,11}      single edge needs none
  (4, 10, 11, 1),
--   {20,21,22}   path        needs 1 closure edge
  (4, 20, 21, 1),
  (5, 21, 22, 1),
--   {30,31,32}   triangle    needs none
  (6, 30, 31, 1),
  (7, 31, 32, 1),
  (8, 32, 30, 1))
AS t(id, source, target, cost);

-- Calculating the invariant results
-- Connected components of dc_mixed, computed with a recursive CTE.
CREATE TEMP TABLE dc_mixed_edges AS
SELECT source::BIGINT AS source, target::BIGINT AS target FROM dc_mixed
UNION ALL
SELECT target::BIGINT, source::BIGINT FROM dc_mixed;

CREATE TEMP TABLE dc_mixed_nodes AS
SELECT source AS node FROM dc_mixed_edges
UNION
SELECT target FROM dc_mixed_edges;

CREATE TEMP TABLE dc_mixed_comp AS
WITH RECURSIVE reach(node, root) AS (
  SELECT node, node FROM dc_mixed_nodes
  UNION
  SELECT e.target, reach.root
  FROM reach JOIN dc_mixed_edges e ON e.source = reach.node
)
SELECT node AS vertex, min(root) AS comp FROM reach GROUP BY node;

-- Calculating the results
CREATE TEMP TABLE dc_mixed_result AS
SELECT start_vid, end_vid
FROM pgr_makeBiconnectedPlanar('SELECT id, source, target, cost FROM dc_mixed');

-- 6. No returned edge may connect vertices of different components.

RETURN QUERY
SELECT is(
  (SELECT count(*)::BIGINT
   FROM dc_mixed_result r
   JOIN dc_mixed_comp cs ON cs.vertex = r.start_vid
   JOIN dc_mixed_comp ct ON ct.vertex = r.end_vid
   WHERE cs.comp <> ct.comp),
  0::BIGINT,
  '6: No added edge crosses a component boundary');

-- 7. Components that are already biconnected are left alone.

RETURN QUERY
SELECT is(
  (SELECT count(*)::BIGINT
   FROM dc_mixed_result
   WHERE start_vid IN (30, 31, 32, 40, 41)
      OR end_vid   IN (30, 31, 32, 40, 41)),
  0::BIGINT,
  '7: Already biconnected components receive no edges');

-- 8. SampleData disconnected graph: a large component plus a couple of fragments.
--    No added edge may cross, and edges must actually be produced.

-- Sample data cut into a large component and a small disconnected fragment
CREATE TEMP TABLE dc_sampledata AS
SELECT id, source, target, cost, reverse_cost FROM edges ;

CREATE TEMP TABLE dc_sample_edges AS
SELECT source::BIGINT AS source, target::BIGINT AS target FROM dc_sampledata
UNION ALL
SELECT target::BIGINT, source::BIGINT FROM dc_sampledata;

CREATE TEMP TABLE dc_sample_nodes AS
SELECT source AS node FROM dc_sample_edges
UNION
SELECT target FROM dc_sample_edges;

CREATE TEMP TABLE dc_sample_comp AS
WITH RECURSIVE reach(node, root) AS (
  SELECT node, node FROM dc_sample_nodes
  UNION
  SELECT e.target, reach.root
  FROM reach JOIN dc_sample_edges e ON e.source = reach.node
)
SELECT node AS vertex, min(root) AS comp FROM reach GROUP BY node;

CREATE TEMP TABLE dc_sample_result AS
SELECT start_vid, end_vid
FROM pgr_makeBiconnectedPlanar(
  'SELECT id, source, target, cost, reverse_cost FROM dc_sampledata');

RETURN QUERY
SELECT is(
  (SELECT count(*)::BIGINT
   FROM dc_sample_result r
   JOIN dc_sample_comp cs ON cs.vertex = r.start_vid
   JOIN dc_sample_comp ct ON ct.vertex = r.end_vid
   WHERE cs.comp <> ct.comp),
  0::BIGINT,
  '8: Disconnected sample data => no added edge crosses a component boundary');

RETURN QUERY
SELECT isnt_empty(
  $$SELECT * FROM dc_sample_result$$,
  '9: Disconnected sample data => edges are still produced');

-- ==========================================================================
-- 10. Correctness: after adding the returned edges no component may have an
--     articulation point. Brute force: for every component and every vertex,
--     the component must stay connected once that vertex is removed.
-- ==========================================================================

CREATE TEMP TABLE dc_aug AS
SELECT * FROM dc_mixed_edges
UNION ALL
SELECT start_vid, end_vid FROM dc_mixed_result
UNION ALL
SELECT end_vid, start_vid FROM dc_mixed_result;

CREATE TEMP TABLE dc_aug_comp AS
WITH RECURSIVE reach(node, root) AS (
  SELECT node, node FROM dc_mixed_nodes
  UNION
  SELECT e.target, reach.root
  FROM reach JOIN dc_aug e ON e.source = reach.node
)
SELECT node AS vertex, min(root) AS comp FROM reach GROUP BY node;

CREATE TEMP TABLE dc_aug_size AS
SELECT comp, count(*) AS n FROM dc_aug_comp GROUP BY comp;

CREATE TEMP TABLE dc_pairs AS
SELECT DISTINCT comp, vertex AS removed FROM dc_aug_comp;

CREATE TEMP TABLE dc_walk AS
WITH RECURSIVE walk(comp, removed, node) AS (
  SELECT p.comp, p.removed, min(a.vertex)
  FROM dc_pairs p
  JOIN dc_aug_comp a ON a.comp = p.comp AND a.vertex <> p.removed
  GROUP BY p.comp, p.removed
  UNION
  SELECT w.comp, w.removed, e.target
  FROM walk w
  JOIN dc_aug e ON e.source = w.node
  JOIN dc_aug_comp a ON a.vertex = e.target AND a.comp = w.comp
  WHERE e.target <> w.removed
)
SELECT * FROM walk;

RETURN QUERY
SELECT is(
  (SELECT count(*)::BIGINT
   FROM dc_pairs p
   JOIN dc_aug_size s ON s.comp = p.comp
   JOIN (
     SELECT comp, removed, count(DISTINCT node) AS reached
     FROM dc_walk GROUP BY comp, removed
   ) r ON r.comp = p.comp AND r.removed = p.removed
   WHERE r.reached <> s.n - 1),
  0::BIGINT,
  '10: No articulation point remains in any component');

END;
$BODY$
LANGUAGE plpgsql;

SELECT disconnected();

SELECT * FROM finish();
ROLLBACK;
