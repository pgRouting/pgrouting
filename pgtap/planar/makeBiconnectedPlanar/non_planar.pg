BEGIN;

SELECT CASE WHEN min_version('4.1.0') THEN plan (4) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION non_planar()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

IF NOT min_version('4.1.0') THEN
  RETURN QUERY
  SELECT skip(1, 'Function is new on 4.1.0');
  RETURN;
END IF;

-- K5: complete graph on 5 vertices (10 edges) is not planar
CREATE TEMP TABLE k5 AS
SELECT id, source, target, cost, reverse_cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::BIGINT, 1::BIGINT),
  (2,  1,  3, 1, 1),
  (3,  1,  4, 1, 1),
  (4,  1,  5, 1, 1),
  (5,  2,  3, 1, 1),
  (6,  2,  4, 1, 1),
  (7,  2,  5, 1, 1),
  (8,  3,  4, 1, 1),
  (9,  3,  5, 1, 1),
  (10, 4,  5, 1, 1))
AS t(id, source, target, cost, reverse_cost);

RETURN QUERY
SELECT throws_ok(
  $$SELECT * FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM k5')$$,
  'XX000',
  'Graph is not planar',
  'K5 (complete graph on 5 vertices) is not planar');

RETURN QUERY
SELECT throws_ok(
  $$SELECT * FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost, reverse_cost FROM k5')$$,
  'XX000',
  'Graph is not planar',
  'K5 (complete graph on 5 vertices) is not planar');

-- A non-planar component must be rejected even when the graph as a whole is
-- disconnected: planarity is verified over every component.
CREATE TEMP TABLE k5_disconnected AS
SELECT id, source, target, cost, reverse_cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::BIGINT, 1::BIGINT),
  (2,  1,  3, 1, 1),
  (3,  1,  4, 1, 1),
  (4,  1,  5, 1, 1),
  (5,  2,  3, 1, 1),
  (6,  2,  4, 1, 1),
  (7,  2,  5, 1, 1),
  (8,  3,  4, 1, 1),
  (9,  3,  5, 1, 1),
  (10, 4,  5, 1, 1),
  -- disconnected planar path 20-21-22
  (11, 20, 21, 1, 1),
  (12, 21, 22, 1, 1))
AS t(id, source, target, cost, reverse_cost);

RETURN QUERY
SELECT throws_ok(
  $$SELECT * FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost FROM k5_disconnected')$$,
  'XX000',
  'Graph is not planar',
  'K5 plus a disconnected planar path is not planar');

-- Same, with the non-planar component listed last: the rejection must not
-- depend on the order the components appear in the edges SQL.
CREATE TEMP TABLE planar_then_k5 AS
SELECT * FROM (
  SELECT id, source, target, cost, reverse_cost
  FROM (VALUES
    (1::BIGINT, 20::BIGINT, 21::BIGINT, 1::BIGINT, 1::BIGINT),
    (2, 21, 22, 1, 1)) AS a(id, source, target, cost, reverse_cost)
  UNION ALL
  SELECT id + 100, source, target, cost, reverse_cost FROM k5) AS u
ORDER BY id;

RETURN QUERY
SELECT throws_ok(
  $$SELECT * FROM pgr_makeBiconnectedPlanar(
    'SELECT id, source, target, cost, reverse_cost FROM planar_then_k5')$$,
  'XX000',
  'Graph is not planar',
  'Disconnected planar component listed before K5 is still not planar');

END;
$BODY$
LANGUAGE plpgsql;

SELECT non_planar();

SELECT * FROM finish();
ROLLBACK;
