BEGIN;

SELECT CASE WHEN min_lib_version('4.0.3') THEN plan(4) ELSE plan(1) END;

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION astarCostMatrixCompareDijkstra()
RETURNS SETOF TEXT AS
$BODY$

BEGIN

  IF min_lib_version('4.0.3') THEN

    RETURN QUERY
    SELECT * from compare_dijkstraCostMatrix('pgr_astarCostMatrix', ', x1,y1,x2,y2 ', 'edges', ',0');

  ELSE

    RETURN query
    SELECT skip(1, 'Fix done on on version 4.0.3');

  END IF;

RETURN;
END
$BODY$
language plpgsql;

SELECT * from astarCostMatrixCompareDijkstra();

SELECT * FROM finish();
ROLLBACK;
