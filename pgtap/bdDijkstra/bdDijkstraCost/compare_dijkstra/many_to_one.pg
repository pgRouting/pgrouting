BEGIN;

SELECT CASE WHEN NOT min_version('3.1.2') THEN plan(1) WHEN min_lib_version('4.0.3') THEN plan(144) ELSE plan(36) END;

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION CompareDijkstra()
RETURNS SETOF TEXT AS
$BODY$

BEGIN

  IF NOT min_version('3.1.2') THEN
    RETURN query
    SELECT skip(1, 'A server crash was fixed on v3.1.2');
    RETURN;
  END IF;

  RETURN QUERY
  SELECT * from compare_dijkstraCost_many_to_one('pgr_bddijkstracost', ' ', 'edges');

  /* fix for asymetric graphs start on v4.0.3 */
  IF min_lib_version('4.0.3') THEN

    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_one('pgr_bddijkstracost', ' ', 'edges_asym');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_one('pgr_bddijkstracost', ' ', 'edges_asym_w_dup_ids');
    RETURN QUERY
    SELECT * from compare_dijkstraCost_many_to_one('pgr_bddijkstracost', ' ', 'edges_asym_w_parallels');

  END IF;

END
$BODY$
language plpgsql;

SELECT * from CompareDijkstra();

SELECT * FROM finish();
ROLLBACK;
