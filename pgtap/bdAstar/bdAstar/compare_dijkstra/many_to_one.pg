BEGIN;

SELECT CASE WHEN min_lib_version('4.0.3') THEN plan(144) WHEN min_version('3.1.1') THEN plan(36) ELSE plan(1) END;

UPDATE edges SET cost = sign(cost) + 0.001 * id * id, reverse_cost = sign(reverse_cost) + 0.001 * id * id;

CREATE or REPLACE FUNCTION CompareDijkstra()
RETURNS SETOF TEXT AS
$BODY$
DECLARE
result_columns TEXT;

BEGIN

  IF min_lib_version('4.0.3') THEN

    RETURN QUERY
    SELECT * from compare_dijkstra_many_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstra_many_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstra_many_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym_w_dup_ids', ',0');
    RETURN QUERY
    SELECT * from compare_dijkstra_many_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges_asym_w_parallels', ',0');

  ELSIF min_version('3.6.0') THEN

    RETURN QUERY
    SELECT * from compare_dijkstra_many_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges', ',0', result_columns);

  ELSIF min_version('3.1.1') THEN

    result_columns := ' seq, path_seq, start_vid, round(cost::numeric,8) AS cost, round(agg_cost::numeric,8) AS agg_cost ';

    RETURN QUERY
    SELECT * from compare_dijkstra_many_to_one('pgr_bdastar', ', x1,y1,x2,y2 ', 'edges', ',0', result_columns);

  ELSE

    RETURN QUERY
    SELECT skip(1, 'A server crash was fixed on v3.1.1');

  END IF;

END
$BODY$
language plpgsql;

SELECT * from CompareDijkstra();

SELECT * FROM finish();
ROLLBACK;
