BEGIN;

UPDATE edges SET cost = sign(cost), reverse_cost = -1 * sign(cost);
SELECT CASE WHEN min_version('4.0.0') THEN plan(6) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION no_direct_cycle()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

  IF NOT min_version('4.0.0') THEN
    RETURN QUERY SELECT skip(1, 'pgr_DAGshortestPath return columns are standardized on v4.0.0');
    RETURN;
  END IF;

  CREATE TABLE parallels (id INTEGER, source INTEGER, target INTEGER, cost FLOAT, reverse_cost FLOAT);

  INSERT INTO parallels (id, source, target, cost, reverse_cost) VALUES
  (1,   3,  6, 20,  15),
  (11,  3,  6, 10, -10),
  (21 , 6,  3, -1,  8);

  RETURN query
  SELECT lives_ok(
    $$
    SELECT seq, path_seq, start_vid, end_vid, node, edge, cost, agg_cost FROM pgr_dagShortestPath(
      'SELECT id, source, target, cost, reverse_cost FROM parallels WHERE id < 2', 3, 6)
    $$
  );

  RETURN query
  SELECT set_eq(
    $$
    SELECT seq, path_seq, start_vid, end_vid, node, edge, cost, agg_cost FROM pgr_dagShortestPath(
      'SELECT id, source, target, cost, reverse_cost FROM parallels WHERE id < 2', 3, 6)
    $$,
    $$VALUES
    (1, 1,  3,  6, 3, 1,  20, 0),
    (2, 2,  3,  6, 6,  -1, 0,  20)$$);


  RETURN query
  SELECT lives_ok(
    $$
    SELECT seq, path_seq, start_vid, end_vid, node, edge, cost, agg_cost FROM pgr_dagShortestPath(
      'SELECT id, source, target, cost, reverse_cost FROM parallels WHERE id < 12', 3, 6)
    $$
  );

  RETURN query
  SELECT set_eq(
    $$
    SELECT seq, path_seq, start_vid, end_vid, node, edge, cost, agg_cost FROM pgr_dagShortestPath(
      'SELECT id, source, target, cost, reverse_cost FROM parallels WHERE id < 12', 3, 6)
    $$,
    $$VALUES
    (1, 1,  3,  6, 3, 11, 10, 0),
    (2, 2,  3,  6, 6, -1, 0, 10)$$);


  RETURN query
  SELECT lives_ok(
    $$
    SELECT seq, path_seq, start_vid, end_vid, node, edge, cost, agg_cost FROM pgr_dagShortestPath(
      'SELECT id, source, target, cost, reverse_cost FROM parallels WHERE id < 22', 3, 6)
    $$
  );

  RETURN query
  SELECT set_eq(
    $$
    SELECT seq, path_seq, start_vid, end_vid, node, edge, cost, agg_cost FROM pgr_dagShortestPath(
      'SELECT id, source, target, cost, reverse_cost FROM parallels WHERE id < 22', 3, 6)
    $$,
    $$VALUES
    (1, 1,  3,  6, 3, 21, 8, 0),
    (2, 2,  3,  6, 6, -1, 0, 8)$$);


END
$BODY$
language plpgsql;

SELECT no_direct_cycle();

-- Finish the tests and clean up.
SELECT finish();
ROLLBACK;
