BEGIN;

SELECT CASE WHEN min_version('4.1.0') THEN plan(2) ELSE plan(1) END;

CREATE OR REPLACE FUNCTION test_cases()
RETURNS SETOF TEXT AS
$BODY$
BEGIN

IF NOT min_version('4.1.0') THEN
  RETURN QUERY SELECT skip(1, 'pgr_withPointsDD: negative distance error implemented on 4.1.0');
  RETURN;
END IF;

RETURN QUERY SELECT throws_ok('wp_dd_neg1',
    'XX000',
    'Negative value found on ''distance''',
    '1: Negative distance throws for single vertex in withPointsDD');

RETURN QUERY SELECT throws_ok('wp_dd_neg2',
    'XX000',
    'Negative value found on ''distance''',
    '2: Negative distance throws for multiple vertices in withPointsDD');

END;
$BODY$
LANGUAGE plpgsql;

PREPARE wp_dd_neg1 AS
SELECT *
FROM pgr_withPointsDD(
    'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
    'SELECT pid, edge_id, fraction, side FROM pointsOfInterest',
    15, -3
);

PREPARE wp_dd_neg2 AS
SELECT *
FROM pgr_withPointsDD(
    'SELECT id, source, target, cost, reverse_cost FROM edges ORDER BY id',
    'SELECT pid, edge_id, fraction, side FROM pointsOfInterest',
    ARRAY[15, 8], -3
);

SELECT test_cases();

SELECT * FROM finish();
ROLLBACK;
