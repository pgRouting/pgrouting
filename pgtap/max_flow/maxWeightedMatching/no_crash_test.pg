BEGIN;

UPDATE edges SET cost = sign(cost), reverse_cost = sign(reverse_cost);
SELECT CASE WHEN min_version('4.1.0') THEN plan(5) ELSE plan(1) END;

PREPARE edges AS
SELECT id, source, target, cost, reverse_cost FROM edges;

CREATE OR REPLACE FUNCTION no_crash()
RETURNS SETOF TEXT AS
$BODY$
DECLARE
    params TEXT[];
    subs TEXT[];
BEGIN
    IF NOT min_version('4.1.0') THEN
        RETURN QUERY
        SELECT skip(1, 'pgr_maxWeightedMatch is new on 4.1.0');
        RETURN;
    END IF;

    params := ARRAY[
        '$$SELECT id, source, target, cost, reverse_cost FROM edges$$'
    ]::TEXT[];

    subs := ARRAY[
        'NULL'
    ]::TEXT[];

    RETURN QUERY
    SELECT * FROM no_crash_test('pgr_maxWeightedMatch', params, subs);

    params := ARRAY[
        '$$edges$$'
    ]::TEXT[];

    RETURN QUERY
    SELECT throw_on_empty_edges_sql('pgr_maxWeightedMatch', '');

END
$BODY$
LANGUAGE plpgsql VOLATILE;

SELECT * FROM no_crash();

SELECT finish();
ROLLBACK;
