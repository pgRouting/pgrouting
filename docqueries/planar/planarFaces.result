-----+---------+---------+------
   1 |       1 |       6 |    1
   2 |       1 |       7 |    1
   3 |       1 |       4 |    1
   4 |       1 |       1 |    1
   5 |       1 |       1 |    2
   6 |       1 |       2 |    1
   7 |       1 |       5 |    1
   8 |       1 |       8 |    2
   9 |       1 |       7 |    2
  10 |       1 |       6 |    2
  11 |       2 |       4 |    1
  12 |       2 |      10 |    1
  13 |       2 |      12 |    2
  14 |       2 |      13 |    1
  15 |       2 |      15 |    1
  16 |       2 |      16 |    1
  17 |       2 |       3 |    2
  18 |       2 |       2 |    2
  19 |       3 |       5 |    2
  20 |       3 |       3 |    1
  21 |       3 |      16 |    2
  22 |       3 |       9 |    2
  23 |       4 |       8 |    1
  24 |       4 |      11 |    1
  25 |       4 |      12 |    1
  26 |       4 |      14 |    1
  27 |       4 |      14 |    2
  28 |       4 |      10 |    2
  29 |       5 |      11 |    2
  30 |       5 |       9 |    1
  31 |       5 |      15 |    2
  32 |       5 |      13 |    2
  33 |       6 |      17 |    1
  34 |       6 |      17 |    2
  35 |       7 |      18 |    1
  36 |       7 |      18 |    2
(36 rows)

/* -- q2 */
CREATE TEMP TABLE k5 AS
SELECT id, source, target, cost
FROM (VALUES
  (1::BIGINT, 1::BIGINT, 2::BIGINT, 1::BIGINT),
  (2,  1,  3, 1),
  (3,  1,  4, 1),
  (4,  1,  5, 1),
  (5,  2,  3, 1),
  (6,  2,  4, 1),
  (7,  2,  5, 1),
  (8,  3,  4, 1),
  (9,  3,  5, 1),
  (10, 4,  5, 1))
AS t(id, source, target, cost);
SELECT 10
/* -- test-planarity */
SELECT pgr_isPlanar('SELECT id, source, target, cost FROM k5');
 pgr_isplanar
--------------
 f
(1 row)

/* -- will throw an error
SELECT * FROM pgr_planarFaces('SELECT id, source, target, cost FROM k5');
-- not testing*/
SELECT * FROM pgr_planarFaces(
  'SELECT 1 AS id, 5 AS source, 5 AS target, 2 AS cost'
) ORDER BY seq;
 seq | face_id | edge_id | side
-----+---------+---------+------
   1 |       1 |       1 |    1
   2 |       2 |       1 |    2
(2 rows)

/* -- end-one-loop */
SELECT * FROM pgr_planarFaces(
  'SELECT 1 AS id, 5 AS source, 5 AS target, 1 AS cost, 1 AS reverse_cost'
) ORDER BY seq;
 seq | face_id | edge_id | side
-----+---------+---------+------
   1 |       1 |       1 |    1
   2 |       1 |       1 |    1
   3 |       2 |       1 |    2
   4 |       3 |       1 |    2
(4 rows)

/* -- end-two-loop */
/* -- q3 */
CREATE TEMP TABLE tri_edges AS
SELECT id, source, target
FROM (VALUES
(11, 1, 2),
(12, 2, 3),
(13, 1, 3))
AS t(id, source, target);
SELECT 3
/* -- tri-no-dup */
SELECT * FROM pgr_planarFaces(
  'SELECT id, source, target, 1 AS cost FROM tri_edges'
) ORDER BY seq;
 seq | face_id | edge_id | side
-----+---------+---------+------
   1 |       1 |      11 |    1
   2 |       1 |      12 |    1
   3 |       1 |      13 |    2
   4 |       2 |      11 |    2
   5 |       2 |      13 |    1
   6 |       2 |      12 |    2
(6 rows)

/* -- q4 */
SELECT * FROM pgr_planarFaces(
  'SELECT id, source, target, 1 AS cost, 1 AS reverse_cost
  FROM tri_edges'
) ORDER BY seq;
 seq | face_id | edge_id | side
-----+---------+---------+------
   1 |       1 |      11 |    1
   2 |       1 |      12 |    1
   3 |       1 |      13 |    2
   4 |       2 |      11 |    2
   5 |       2 |      11 |    1
   6 |       3 |      11 |    1
   7 |       3 |      13 |    1
   8 |       3 |      12 |    2
   9 |       4 |      12 |    2
  10 |       4 |      12 |    1
  11 |       5 |      13 |    2
  12 |       5 |      13 |    1
(12 rows)

/* -- q5 */
ROLLBACK;
ROLLBACK
