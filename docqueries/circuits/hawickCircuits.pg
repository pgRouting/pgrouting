/* -- q1 */
SELECT * FROM pgr_hawickCircuits(
  'SELECT id, source, target, cost, reverse_cost FROM edges'
);
/* -- q2 */
SELECT * FROM pgr_hawickCircuits(
  'SELECT id, source, target, cost, reverse_cost FROM edges', 10
);
/* -- q3 */
SELECT * FROM pgr_hawickCircuits(
  'SELECT id, source, target, cost, reverse_cost FROM edges', ARRAY[10,11]
);
/* -- q4 */
CREATE TABLE c_example (
  id BIGINT,
  source BIGINT,
  target BIGINT,
  cost FLOAT,
  reverse_cost FLOAT
);

INSERT INTO c_example (id, source, target, cost, reverse_cost) VALUES
(1, 1, 2, 1,  1),
(2, 2, 3, 1,  1),
(3, 1, 3, 1, 1),
(4, 1, 3, 1.5, 1.7),
(5, 1, 4, 1,  1),
(6, 1, 5, 1, -1),
(7, 1, 1, 1, -1);

/* -- q5 */
SELECT * FROM pgr_hawickCircuits(
  'SELECT id, source, target, cost, reverse_cost FROM c_example', 1
);
/* -- q6 */
SELECT * FROM pgr_hawickCircuits(
  'SELECT id, source, target, cost, reverse_cost FROM c_example', 1,
  self_loops := false
);
/* -- q7 */
SELECT * FROM pgr_hawickCircuits(
  'SELECT id, source, target, cost, reverse_cost FROM c_example', 1,
  self_loops => false, u_turn_on_edge => false
);
/* -- q8 */
